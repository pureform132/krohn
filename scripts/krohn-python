#!/usr/bin/env bash
# Run Python in this checkout's environment: `scripts/krohn-python ARGS...`.
#
# A GitHub Actions job runs the interpreter setup-pm exported as KROHN_PYTHON,
# so a recipe never re-runs setup on a runner. Anywhere else KROHN_PYTHON may
# be inherited from a wrapped `krohn` (a release venv without the dev tools),
# so scripts/run-in-krohn-env applies (and if stale, syncs) the environment
# `source ./activate` gives a shell.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${__KROHN_ACTIVATED:-}" ] && [ -n "${KROHN_PYTHON:-}" ] \
    && [ -x "$KROHN_PYTHON" ]; then
    exec "$KROHN_PYTHON" "$@"
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-in-krohn-env" python "$@"
