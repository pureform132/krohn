#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the KROHN dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `krohn` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-krohn-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `krohn pm
# install` and `krohn update` keep that check.
# ============================================================================
_KROHN_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_krohn_test_env="--test-environment"
_krohn_expect_extras=""
for _krohn_arg in "$@"; do
    if [ -n "$_krohn_expect_extras" ]; then
        _krohn_test_env="--test-environment=$_krohn_arg"
        _krohn_expect_extras=""
        continue
    fi
    case "$_krohn_arg" in
        --) break ;;
        --test-extras) _krohn_expect_extras=1 ;;
        --test-extras=*) _krohn_test_env="--test-environment=${_krohn_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_krohn_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _krohn_arg _krohn_test_env _krohn_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _krohn_arg _krohn_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_KROHN_REPO/scripts/_activation.sh"

if ! krohn_sync "$_KROHN_REPO" "$_krohn_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _krohn_test_env
    return 1 2>/dev/null || exit 1
fi
unset _krohn_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __KROHN_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_krohn_script="$(krohn_compose_env "$_KROHN_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _krohn_script
    return 1 2>/dev/null || exit 1
}
_krohn_keys="$(printf '%s\n' "$_krohn_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __KROHN_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__KROHN_SAVED_PATH="$PATH"
for _krohn_k in $_krohn_keys; do
    eval "__KROHN_SAVED_$_krohn_k=\"\${$_krohn_k+set}\""
    eval "__KROHN_PRIOR_$_krohn_k=\${$_krohn_k-__KROHN_UNSET__}"
done
krohn_apply_env "$_krohn_script"

# This checkout, not whichever `krohn` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__KROHN_WORKTREE="$_KROHN_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__KROHN_WORKTREE_NAME="$(git -C "$_KROHN_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__KROHN_WORKTREE_NAME" ] || [ "$__KROHN_WORKTREE_NAME" = HEAD ]; then
    __KROHN_WORKTREE_NAME="$(basename "$_KROHN_REPO")"
fi
__KROHN_SAVED_PS1="${PS1-__KROHN_UNSET__}"
__KROHN_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__KROHN_UNSET__}"

_krohn_worktree_here() {
    _krohn_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_krohn_top" && pwd -P)" = "$(cd "$__KROHN_WORKTREE" && pwd -P)" ]
}

krohn() {
    _krohn_worktree_here || {
        printf '%s\n' "krohn: $(pwd) is outside $__KROHN_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__KROHN_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" krohn "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe krohn "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python krohn "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe krohn "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python krohn "$@"
        else
            exec python krohn "$@"
        fi
    )
}

_krohn_prompt() {
    if [ "$__KROHN_SAVED_PS1" = "__KROHN_UNSET__" ]; then
        _krohn_base_ps1=""
    else
        _krohn_base_ps1="$__KROHN_SAVED_PS1"
    fi
    if _krohn_worktree_here; then
        PS1="($__KROHN_WORKTREE_NAME) $_krohn_base_ps1"
    else
        PS1="$_krohn_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_krohn_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_krohn_prompt
fi
_krohn_prompt

deactivate() {
    export PATH="$__KROHN_SAVED_PATH"
    for _krohn_k in $__KROHN_KEY_LIST; do
        eval "_krohn_was=\"\$__KROHN_SAVED_$_krohn_k\""
        eval "_krohn_old=\"\$__KROHN_PRIOR_$_krohn_k\""
        if [ "$_krohn_was" != "set" ]; then
            unset "$_krohn_k"
        else
            export "$_krohn_k=$_krohn_old"
        fi
        unset "__KROHN_SAVED_$_krohn_k" "__KROHN_PRIOR_$_krohn_k"
    done
    if [ "$__KROHN_SAVED_PS1" = "__KROHN_UNSET__" ]; then
        unset PS1
    else
        PS1="$__KROHN_SAVED_PS1"
    fi
    if [ "$__KROHN_SAVED_PROMPT_COMMAND" = "__KROHN_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__KROHN_SAVED_PROMPT_COMMAND"
    fi
    unset __KROHN_SAVED_PATH __KROHN_KEY_LIST __KROHN_ACTIVATED \
          __KROHN_WORKTREE __KROHN_WORKTREE_NAME \
          __KROHN_SAVED_PS1 __KROHN_SAVED_PROMPT_COMMAND
    unset -f deactivate krohn _krohn_worktree_here _krohn_prompt
    unset _krohn_k _krohn_was _krohn_old _krohn_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__KROHN_KEY_LIST="$_krohn_keys"

# The composition library is not part of the user's shell.
unset -f krohn_sync krohn_bootstrap_python krohn_compose_env krohn_apply_env \
         krohn_activation_current krohn_ensure_env
unset _KROHN_REPO _krohn_script _krohn_keys _krohn_k _krohn_top
